<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ============================= -->
    <!-- Glassmorphism Color Palette -->
    <!-- ============================= -->

    <!-- Main Background -->
    <color name="background_dark">#090B15</color>
    <color name="background_secondary">#111827</color>

    <!-- Glass Panel -->
    <color name="glass_color">#22FFFFFF</color>
    <color name="glass_border">#44FFFFFF</color>

    <!-- Neon Accent -->
    <color name="accent_blue">#00E5FF</color>
    <color name="accent_purple">#8B5CF6</color>

    <!-- Text -->
    <color name="text_primary">#FFFFFFFF</color>
    <color name="text_secondary">#B8C5D6</color>

    <!-- Existing References -->
    <color name="no_content_text_color">@color/text_primary</color>

    <color name="album_art_background">#182032</color>

    <!-- Background behind playback controls -->
    <color name="browse_playback_bg_color">@color/background_dark</color>

    <!-- Progress Bar -->
    <color name="progress_bar_background">#25FFFFFF</color>
    <color name="progress_bar_highlight">@color/accent_blue</color>
    <color name="progress_bar_thumb_color">@color/accent_blue</color>

    <!-- App Bar -->
    <color name="appbar_view_icon_tint">@color/text_primary</color>
    <color name="appbar_view_settings_tint">@color/accent_blue</color>

    <!-- Search -->
    <color name="search_hint_text_color">#88FFFFFF</color>
    <color name="search_bar_underline_color">@color/accent_blue</color>

    <!-- Queue -->
    <color name="queue_playing_icon_color">@color/accent_blue</color>

</resources>
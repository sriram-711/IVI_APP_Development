<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="24dp"
    android:background="@drawable/glass_card"
    android:padding="24dp">

    <!-- Album Artwork -->

    <FrameLayout
        android:id="@+id/art_container"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:background="@drawable/album_shadow"
        android:padding="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageView
            android:id="@+id/album_art"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/album_round"
            android:clipToOutline="true"
            android:contentDescription="@string/album_art"
            android:scaleType="centerCrop"
            android:transitionName="@string/album_art"/>

    </FrameLayout>

    <!-- Song Title -->

    <TextView
        android:id="@+id/title"
        style="@style/MetadataPlaybackTitleStyle"
        android:fontFamily="@font/mama"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="28dp"
        android:textColor="#FFFFFF"
        android:textSize="34sp"
        android:textStyle="normal"
        android:maxLines="2"
        app:layout_constraintStart_toEndOf="@id/art_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/art_container"/>

    <!-- Artist -->

    <TextView
        android:id="@+id/artist"
        style="@style/MetadataPlaybackSubtitleStyle"
        android:fontFamily="@font/mama"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:textColor="#C7D2FE"
        android:textSize="22sp"
        app:layout_constraintStart_toStartOf="@id/title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/title"/>

    <!-- Album -->

    <TextView
        android:id="@+id/album_title"
        style="@style/MetadataPlaybackSubtitleStyle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="#8BE9FD"
        android:textSize="18sp"
        android:maxLines="1"
        app:layout_constraintStart_toStartOf="@id/title"
        app:layout_constraintEnd_toStartOf="@id/progress_text_container"
        app:layout_constraintTop_toBottomOf="@id/artist"
        app:layout_constraintBottom_toBottomOf="@id/art_container"/>

    <!-- Time -->

    <include
        android:id="@+id/progress_text_container"
        layout="@layout/time_progress_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@id/album_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/album_title"/>

</androidx.constraintlayout.widget.ConstraintLayout>
package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

// Core library shared by the main app and test suites
android_library {
    name: "CarSettings-core",
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    static_libs: [
        "car-ui-lib",
        "car-apps-common",
        "car-media-common",
        "car-uxr-client-lib",
        "androidx.preference_preference",
        "androidx-constraintlayout_constraintlayout",
        "androidx.lifecycle_lifecycle-extensions",
    ],
    libs: ["android.car-system-stubs"],
}

// 1. The Main Target (The production app being deployed)
android_app {
    name: "CarSettings",
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    platform_apis: true,
    certificate: "platform",
    privileged: true,
    static_libs: ["CarSettings-core"],
    required: ["allowed_privapp_com.android.car.settings"],
    optimize: {
        enabled: false,
    },
    dex_preopt: {
        enabled: false,
    },
}

// 2. The Robolectric Testing Target (Satisfies tests/robotests/Android.bp)
android_app {
    name: "CarSettingsAppForTesting",
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    platform_apis: true,
    certificate: "platform",
    privileged: true,
    static_libs: ["CarSettings-core"],
    required: ["allowed_privapp_com.android.car.settings"],
    optimize: {
        enabled: false,
    },
}

// 3. The Unit Testing Target (Satisfies tests/unit/Android.bp)
android_library {
    name: "CarSettingsLibForDeviceTesting",
    static_libs: [
        "CarSettings-core",
    ],
    manifest: "AndroidManifest.xml",
}
package com.android.car.carlauncher;

import android.os.Bundle;
import android.view.View;
import androidx.fragment.app.FragmentActivity;

/**
 * Super minimal Launcher that forces a clean background image.
 */
public class CarLauncher extends FragmentActivity {
    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);
        setContentView(R.layout.car_launcher);
        
        // Force hide anything that might be added by overlays or system
        View top = findViewById(R.id.top_card);
        if (top != null) top.setVisibility(View.GONE);
        
        View bottom = findViewById(R.id.bottom_card);
        if (bottom != null) bottom.setVisibility(View.GONE);
        
        View maps = findViewById(R.id.maps_card);
        if (maps != null) maps.setVisibility(View.GONE);
    }
}
